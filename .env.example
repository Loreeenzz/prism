NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Canonical app origin. Use http://localhost:3000 locally and your production URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel can provide the current preview hostname automatically when configured for the project.
NEXT_PUBLIC_VERCEL_URL=
# Optional Sentry error tracking. Leave blank until a Sentry project is created.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Required only for Sentry source-map uploads during production builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
